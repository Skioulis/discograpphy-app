# Copy this file to `.env` (same directory as docker-compose.yml) and fill in
# real values. docker compose auto-loads `.env`. Do NOT commit the real `.env`.

# --- Database (used by both the Postgres container and the app) ---
DB_USER=discography
DB_PASSWORD=change-me-to-a-strong-password
DB_NAME=discography

# --- Flask ---
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-hex-string

# --- Host port the app is exposed on (http://<pi-ip>:WEB_PORT) ---
WEB_PORT=9292

# --- Host path for external media (mp3s / images), bind-mounted to /app/media ---
# On CasaOS a typical persistent location is under /DATA, e.g.:
#   MEDIA_HOST_PATH=/DATA/AppData/discography/media
MEDIA_HOST_PATH=./media
